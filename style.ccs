* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body {
    font-family: Arial, sans-serif;

    background: #111;

    color: white;
}


/* =========================
   HEADER
========================= */

.header {

    min-height: 80px;

    background: #0b0b0b;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 20px 8%;

    border-bottom: 1px solid #333;

}


.logo {

    font-size: 28px;

    font-weight: bold;

    letter-spacing: 5px;

    color: #d4af37;

}


nav {

    display: flex;

    gap: 30px;

}


nav a {

    color: white;

    text-decoration: none;

    font-size: 16px;

    transition: 0.3s;

}


nav a:hover {

    color: #d4af37;

}


nav a.active {

    color: #d4af37;

}


/* =========================
   HERO
========================= */

.hero {

    min-height: 650px;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    background:
        linear-gradient(
            rgba(0,0,0,0.65),
            rgba(0,0,0,0.85)
        ),
        linear-gradient(
            135deg,
            #542b14,
            #171717
        );

}


.hero-content {

    max-width: 700px;

    padding: 30px;

    animation: appear 1.2s ease;

}


.small-title {

    color: #d4af37;

    letter-spacing: 4px;

    font-size: 13px;

    margin-bottom: 15px;

}


.hero h1 {

    font-size: 100px;

    font-family: Georgia, serif;

    color: #d4af37;

    margin-bottom: 20px;

}


.hero p {

    font-size: 18px;

    line-height: 1.7;

    color: #ddd;

    margin-bottom: 30px;

}


/* =========================
   BUTTON
========================= */

.button,
button {

    display: inline-block;

    background: #d4af37;

    color: #111;

    border: none;

    padding: 14px 28px;

    text-decoration: none;

    font-weight: bold;

    cursor: pointer;

    transition: 0.3s;

}


.button:hover,
button:hover {

    background: white;

    transform: translateY(-3px);

}


/* =========================
   ABOUT
========================= */

.about {

    padding: 100px 10%;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 60px;

    background: #181818;

}


.about-text {

    display: flex;

    flex-direction: column;

    justify-content: center;

}


.about h2 {

    font-size: 48px;

    font-family: Georgia, serif;

    margin-bottom: 20px;

}


.about p {

    line-height: 1.8;

    color: #aaa;

    margin-bottom: 30px;

}


.about-card {

    padding: 60px 40px;

    border: 1px solid #444;

    text-align: center;

    transition: 0.4s;

}


.about-card:hover {

    border-color: #d4af37;

    transform: translateY(-10px);

}


.about-icon {

    font-size: 65px;

    margin-bottom: 20px;

}


.about-card h3 {

    color: #d4af37;

    font-size: 25px;

    margin-bottom: 15px;

}


/* =========================
   ADVANTAGES
========================= */

.advantages {

    padding: 80px 10%;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 30px;

    background: #111;

}


.advantage {

    text-align: center;

    padding: 35px;

    border: 1px solid #333;

    transition: 0.3s;

}


.advantage:hover {

    border-color: #d4af37;

}


.advantage span {

    font-size: 45px;

}


.advantage h3 {

    color: #d4af37;

    margin: 15px 0;

}


.advantage p {

    color: #999;

}


/* =========================
   PAGE TITLE
========================= */

.page-title {

    text-align: center;

    padding: 90px 20px 60px;

    background: #181818;

}


.page-title h1 {

    font-size: 60px;

    font-family: Georgia, serif;

    color: #d4af37;

    margin-bottom: 15px;

}


.page-title p:last-child {

    color: #aaa;

}


/* =========================
   MENU
========================= */

.menu {

    max-width: 1300px;

    margin: auto;

    padding: 70px 30px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 30px;

}


.food-card {

    background: #1b1b1b;

    border: 1px solid #333;

    border-radius: 10px;

    overflow: hidden;

    display: flex;

    min-height: 240px;

    transition: 0.4s;

}


.food-card:hover {

    transform: translateY(-8px);

    border-color: #d4af37;

    box-shadow:
        0 10px 30px rgba(0,0,0,0.4);

}


.food-card img {

    width: 230px;

    height: 240px;

    object-fit: cover;

    transition: 0.5s;

}


.food-card:hover img {

    transform: scale(1.08);

}


.food-info {

    padding: 25px;

    flex: 1;

    display: flex;

    flex-direction: column;

}


.category {

    color: #d4af37;

    font-size: 11px;

    letter-spacing: 3px;

    font-weight: bold;

}


.food-info h2 {

    margin-top: 10px;

    margin-bottom: 12px;

    font-family: Georgia, serif;

}


.food-info p {

    color: #999;

    line-height: 1.6;

    font-size: 14px;

}


.price {

    margin-top: auto;

    padding-top: 20px;

    display: flex;

    align-items: center;

    justify-content: space-between;

}


.price span {

    color: white;

    font-size: 19px;

    font-weight: bold;

}


.price button {

    padding: 10px 15px;

    font-size: 13px;

}


/* =========================
   CONTACTS
========================= */

.contacts {

    max-width: 1200px;

    margin: auto;

    padding: 90px 30px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 70px;

}


.contact-item {

    display: flex;

    gap: 20px;

    margin-bottom: 40px;

}


.contact-item > span {

    font-size: 35px;

}


.contact-item h3 {

    color: #d4af37;

    margin-bottom: 8px;

}


.contact-item p {

    color: #999;

}


/* =========================
   BOOKING
========================= */

.booking {

    background: #1b1b1b;

    padding: 40px;

    border: 1px solid #333;

}


.booking h2 {

    color: #d4af37;

    font-family: Georgia, serif;

    font-size: 30px;

    margin-bottom: 15px;

}


.booking-text {

    color: #999;

    line-height: 1.6;

    margin-bottom: 25px;

}


.booking input {

    width: 100%;

    padding: 15px;

    margin-bottom: 15px;

    background: #111;

    border: 1px solid #444;

    color: white;

    outline: none;

}


.booking input:focus {

    border-color: #d4af37;

}


.booking button {

    width: 100%;

    margin-top: 5px;

}


/* =========================
   FOOTER
========================= */

footer {

    text-align: center;

    padding: 30px;

    background: #0b0b0b;

    color: #666;

    border-top: 1px solid #222;

}


/* =========================
   ANIMATION
========================= */

@keyframes appear {

    from {

        opacity: 0;

        transform: translateY(30px);

    }

    to {

        opacity: 1;

        transform: translateY(0);

    }

}


/* =========================
   MOBILE
========================= */

@media (max-width: 900px) {

    .header {

        flex-direction: column;

        gap: 20px;

    }


    nav {

        flex-wrap: wrap;

        justify-content: center;

    }


    .hero h1 {

        font-size: 65px;

    }


    .about {

        grid-template-columns: 1fr;

    }


    .advantages {

        grid-template-columns: 1fr;

    }


    .menu {

        grid-template-columns: 1fr;

    }


    .contacts {

        grid-template-columns: 1fr;

    }

}


@media (max-width: 600px) {

    .hero {

        min-height: 550px;

    }


    .hero h1 {

        font-size: 50px;

    }


    .page-title h1 {

        font-size: 42px;

    }


    .food-card {

        flex-direction: column;

    }


    .food-card img {

        width: 100%;

        height: 250px;

    }


    .price {

        margin-top: 25px;

    }

}
